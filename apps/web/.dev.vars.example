# Local Worker secrets for `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy to .dev.vars (git-ignored); never commit a value.
#
# In stage/prod these are Worker secrets, not wrangler vars: set once per
# environment with `wrangler secret put <NAME> --name ai-chatbot-web-<env>`
# (README → Deploying); the deploy lane does not set them. The database is
# not here: the Worker reaches it through the HYPERDRIVE binding
# (wrangler.jsonc), and attachments go to the BLOB bucket binding.
AUTH_SECRET=change-me-openssl-rand-base64-32
AI_GATEWAY_API_KEY=
# Optional. Cloudflare Web Analytics token; build-time (NEXT_PUBLIC_) so it
# belongs in .env.local for `next build`, not here.
