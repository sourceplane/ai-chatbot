# Local development with Next's dev server (`pnpm --filter @app/web dev`).
# Copy to .env.local (git-ignored); never commit a value.

# generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=****

# Vercel AI Gateway key (https://vercel.com/ai-gateway). The template's model
# calls go through the gateway from the Worker exactly as they did from a
# Vercel function; on Workers there is no OIDC, so the key is required.
AI_GATEWAY_API_KEY=****

# Postgres for drizzle-kit (`pnpm --filter @app/web db:migrate`, db:studio,
# db:push) and for `next dev` only when no Cloudflare context is available.
# Under `next dev` and `wrangler dev` the app reads the HYPERDRIVE binding
# from wrangler.jsonc instead (its localConnectionString, same database).
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres

# Optional. Cloudflare Web Analytics beacon token (stands in for Vercel
# Analytics). Unset → no script is rendered.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Not used on Workers: attachments go to the BLOB R2 binding
# (BLOB_READ_WRITE_TOKEN is gone) and resumable streams / the Redis IP rate
# limit stay off without REDIS_URL, as upstream intends.
