# Local development with Next's dev server (`pnpm --filter @app/web dev`) and
# drizzle-kit. Copy to .env.local (git-ignored); never commit a value.

# Postgres for drizzle-kit (`pnpm --filter @app/web db:migrate`, db:studio,
# db:push) and for `next dev` only when no Cloudflare context is available.
# Under `next dev` and `wrangler dev` the app reads the HYPERDRIVE binding
# from wrangler.jsonc instead (its localConnectionString, same database).
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres

# Optional. The session key; unset, the one the migrations generated in the
# database (`openssl rand -base64 32` to set your own).
AUTH_SECRET=

# Optional. The models are Workers AI through the AI binding (remote under
# `next dev`: `wrangler login` first). A Vercel AI Gateway key
# (https://vercel.com/ai-gateway) adds upstream's gateway models.
AI_GATEWAY_API_KEY=

# Optional. A Hugging Face token with "Make calls to Inference Providers"
# (https://huggingface.co/settings/tokens) adds Hugging Face's open models.
HF_TOKEN=

# Optional. Cloudflare Web Analytics beacon token (stands in for Vercel
# Analytics). Unset → no script is rendered.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Optional. Redis for resumable streams and the per-IP rate limit; unset,
# both stay off, as upstream intends. Attachments go to the BLOB R2 binding
# (BLOB_READ_WRITE_TOKEN is gone).
REDIS_URL=
