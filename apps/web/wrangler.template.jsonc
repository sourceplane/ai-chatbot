// Rendered to wrangler.jsonc (git-ignored) by tooling/wire: the verify lane
// renders from wiring.fixture.json, the deploy lane from the wiring documents
// the `cloudflare-hyperdrive` and `cloudflare-r2` Terraform roots
// lease-publish (WIRING_CLOUDFLARE_HYPERDRIVE_<ENV>, WIRING_CLOUDFLARE_R2_<ENV>).
// The workers-assets composition deploys one environment per job with no
// wrangler `--env`, so `__ENV__` names the environment this config is
// rendered for.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-chatbot-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // The Supabase project's Postgres, fronted by Hyperdrive. lib/db/queries.ts
  // builds its `postgres` client per call from env.HYPERDRIVE.connectionString
  // (upstream read POSTGRES_URL at module scope). Locally — `wrangler dev`,
  // `next dev` — the binding points at a Postgres on localhost (README →
  // Local development); `pnpm --filter @app/web db:migrate` applies the
  // schema to it.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "@@wiring(cloudflare-hyperdrive/__ENV__:hyperdrive_id)@@",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres"
    }
  ],
  // Chat attachments. Vercel Blob's `put()` becomes a put into this bucket
  // (app/(chat)/api/files/upload/route.ts) and the Worker serves the objects
  // back at /api/files/<key> (app/(chat)/api/files/[...key]/route.ts).
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "@@wiring(cloudflare-r2/__ENV__:r2_bucket_name)@@"
    }
  ]
  // AUTH_SECRET and AI_GATEWAY_API_KEY are Worker secrets, never vars:
  // .dev.vars locally, `wrangler secret put` per environment (README →
  // Deploying). REDIS_URL is deliberately absent: without it the template
  // skips resumable streams and the Redis IP rate limit, as upstream does.
}
